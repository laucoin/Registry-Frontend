# Server-only wiring & secrets, injected at deploy (never in the image).
NUXT_REGISTRY_BASE_URL=http://localhost:8081
NUXT_IDP_ISSUER=http://localhost:9000/application/o/registry/
NUXT_IDP_CLIENT_ID=registry
NUXT_IDP_CLIENT_SECRET= # FIXME: Authentik > Applications > Providers > registry > Client secret
NUXT_SESSION_SECRET= # FIXME: openssl rand -base64 32
# NUXT_APP_CONFIG_PATH=/absolute/path/to/config.json  (defaults to ./config/config.json)
# NUXT_TELEMETRY_OTLP_ENDPOINT=http://localhost:4318  (collector; empty → log only)
NUXT_PRODUCTION=false

# Public (served to the browser) — hosting provider shown on /legal, required by
# LCEN art. 6 III. With NUXT_PRODUCTION=true all three are MANDATORY: a missing
# or blank value aborts boot (server/utils/legal-hosting.ts), like a bad
# config.json. Left unset in development the page states that the details are
# not configured rather than rendering a blank section.
NUXT_PUBLIC_LEGAL_HOSTING_NAME= # FIXME: host's name or company name, e.g. "OVH SAS"
NUXT_PUBLIC_LEGAL_HOSTING_ADDRESS= # FIXME: e.g. "2 rue Kellermann, 59100 Roubaix, France"
NUXT_PUBLIC_LEGAL_HOSTING_PHONE= # FIXME: e.g. "+33 9 72 10 10 07"
