# Copy to .env for local development (gitignored). In production these are set on the
# host/container itself (Docker, PM2, ...) — never baked into the build/image.

# Base URL of the backend API.
BACKEND_URL=http://localhost:8081

# Comma-separated hostnames (no port, no scheme) the SSR server will accept requests
# for — Angular's built-in SSRF guard (see https://angular.dev/best-practices/security
# #preventing-server-side-request-forgery-ssrf) rejects every request whose Host header
# isn't listed here, itself included: the app's own boot-time fetch of /api/config is a
# same-origin request built from the incoming Host header, so this must be set even for
# the app to render its own login page. Unset (or empty) rejects everything — there is
# no permissive default. In production, set this to the public hostname(s) users/your
# reverse proxy actually use (e.g. registry.example.com).
NG_ALLOWED_HOSTS=localhost

# The organization this instance is deployed for (Registry is a SaaS deployed per
# organization — SGDF is only the origin use case, not a hardcoded assumption). Shown on
# the login screen and referenced throughout the legal pages.
ORGANIZATION_NAME=
ORGANIZATION_WEBSITE=

# The creator information (used for copyright notice in the footer). Shown on the login screen and referenced throughout the legal pages.
CREATOR_NAME=Luc Aucoin
CREATOR_WEBSITE=https://doc.laucoin.fr/resume/
CREATOR_EMAIL=luc.aucoin1998@gmail.com

# Displayed in the /terms and /privacy legal notices (hébergeur).
HOSTING_PROVIDER_NAME=
HOSTING_PROVIDER_ADDRESS=

# Repository issues URL, linked from the "Support" entry in the footer. Left unset, the
# link is hidden.
SUPPORT_ISSUES_URL=https://github.com/laucoin/Registry-Frontend/issues
