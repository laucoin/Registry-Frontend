{
    "tagFormat": "${version}",
    "repositoryUrl": "https://github.com/laucoin/Registry-Frontend.git",
    "branches": [
        "main"
    ],
    "plugins": [
        [
            "@semantic-release/commit-analyzer",
            {
                "preset": "conventionalcommits",
                "releaseRules": [
                    {
                        "type": "refactor",
                        "release": "patch"
                    },
                    {
                        "type": "build",
                        "release": "patch"
                    },
                    {
                        "type": "chore",
                        "release": "patch"
                    },
                    {
                        "type": "style",
                        "release": "patch"
                    },
                    {
                        "type": "docs",
                        "release": "patch"
                    },
                    {
                        "type": "test",
                        "release": "patch"
                    },
                    {
                        "type": "revert",
                        "release": "patch"
                    }
                ]
            }
        ],
        [
            "@semantic-release/release-notes-generator",
            {
                "preset": "conventionalcommits",
                "presetConfig": {
                    "types": [
                        {
                            "type": "build",
                            "section": "👷 Automation",
                            "hidden": false
                        },
                        {
                            "type": "chore",
                            "section": "📦️ Other",
                            "hidden": false
                        },
                        {
                            "type": "feat",
                            "section": "🚀 Features",
                            "hidden": false
                        },
                        {
                            "type": "perf",
                            "section": "🏎️ Improvements",
                            "hidden": false
                        },
                        {
                            "type": "refactor",
                            "section": "🧹 Improvements",
                            "hidden": false
                        },
                        {
                            "type": "revert",
                            "section": "⏪ Retore",
                            "hidden": false
                        },
                        {
                            "type": "style",
                            "section": "💄 Improvements",
                            "hidden": false
                        },
                        {
                            "type": "ci",
                            "section": "👷 Automation",
                            "hidden": false
                        },
                        {
                            "type": "docs",
                            "section": "📝 Documentation",
                            "hidden": false
                        },
                        {
                            "type": "fix",
                            "section": "🐛 Bug Fixes",
                            "hidden": false
                        },
                        {
                            "type": "test",
                            "section": "🧪 Tests",
                            "hidden": false
                        }
                    ]
                }
            }
        ],
        "@semantic-release/changelog",
        [
            "@semantic-release/npm",
            {
                "npmPublish": false
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "CHANGELOG.md",
                    "package.json"
                ],
                "message": "ci(release): ${nextRelease.version}\n\n${nextRelease.notes} [skip ci]"
            }
        ],
        "@semantic-release/github"
    ]
}
